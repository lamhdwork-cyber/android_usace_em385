<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="com.navfac.usace.safety.base.db.AppendicesEntity" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/myColorBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/item_appendices_cl_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/myColorBackground"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/item_appendices_tv_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:fontFamily="@font/sf_pro_display_regular"
                android:paddingStart="@dimen/margin_regular"
                android:paddingEnd="0dp"
                android:paddingVertical="10dp"
                android:text="@{String.format(@string/label_sections_subtitle, item.ordinal, item.title)}"
                android:textColor="@color/myColorForeground"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="a General" />

            <View
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:background="@color/myColorDarkGray"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/item_appendices_tv_header" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>