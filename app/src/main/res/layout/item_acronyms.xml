<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/glossary_relative_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/myColorBackground" >

    <TextView
        android:id="@+id/item_acronyms_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/colorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/item_acronyms_filestatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Abrasive blasting" />

    <TextView
        android:id="@+id/item_acronyms_definition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/item_acronyms_name"
        android:layout_marginTop="5dp"
        android:textColor="@color/myColorForeground"
        app:layout_constraintEnd_toEndOf="@+id/item_acronyms_filestatus"
        app:layout_constraintStart_toStartOf="@+id/item_acronyms_name"
        app:layout_constraintTop_toBottomOf="@+id/item_acronyms_name"
        tools:text="the forcible application of an abrasive to a surface by pneumatic pressure, hydraulic pressure, or centrifugal force." />

    <TextView
        android:id="@+id/item_acronyms_filestatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="10dp"
        android:text="@string/item_new"
        android:textAllCaps="true"
        android:textColor="@color/newItemColor"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/item_acronyms_name"
        app:layout_constraintEnd_toStartOf="@+id/item_acronyms_menu"
        app:layout_constraintTop_toTopOf="@+id/item_acronyms_name" />

    <ImageView
        android:id="@+id/item_acronyms_menu"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="15dp"
        android:layout_toStartOf="@+id/item_acronyms_filestatus"
        app:layout_constraintBottom_toBottomOf="@+id/item_acronyms_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_acronyms_name"
        app:srcCompat="@drawable/ic_bookmark_gray_asset" />

    <View
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/item_acronyms_name"
        app:layout_constraintTop_toBottomOf="@+id/item_acronyms_definition" />

</androidx.constraintlayout.widget.ConstraintLayout>
