<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/glossary_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/myColorBackground" >

    <TextView
        android:id="@+id/item_title_figform"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:textColor="@color/colorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Figure 1-1a" />

    <TextView
        android:id="@+id/item_shortnote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/item_title_figform"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/myColorForeground"
        app:layout_constraintEnd_toStartOf="@+id/item_icon_menu"
        app:layout_constraintStart_toStartOf="@+id/item_title_figform"
        app:layout_constraintTop_toBottomOf="@+id/item_title_figform"
        tools:text="Position Harzard Analysis (PHA)" />

    <ImageView
        android:id="@+id/item_icon_menu"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="15dp"
        android:layout_toStartOf="@+id/item_shortnote"
        app:layout_constraintBottom_toBottomOf="@+id/item_title_figform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_title_figform"
        app:srcCompat="@drawable/ic_bookmark_gray_asset"
        tools:ignore="RtlHardcoded" />

    <View
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"
        android:background="@color/myColorDarkGray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/item_title_figform"
        app:layout_constraintTop_toBottomOf="@+id/item_shortnote" />

</androidx.constraintlayout.widget.ConstraintLayout>
